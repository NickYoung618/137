{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slot-pose-result.schema.json",
  "title": "A端面槽姿态算法结果 v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "createdAtUtc", "image", "algorithm", "result", "technicalStatus", "error", "diagnostics"],
  "properties": {
    "schemaVersion": {"const": "slot-pose-result/2"},
    "taskId": {"type": "string", "minLength": 1},
    "createdAtUtc": {"type": "string", "format": "date-time"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "format", "width", "height", "mode"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "format": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "mode": {"type": "string", "minLength": 1}
      }
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configSha256", "configId", "assets"],
      "properties": {
        "name": {"const": "legacy-a-end-face-slot-pose-adapter"},
        "version": {"type": "string", "minLength": 1},
        "configSha256": {"$ref": "#/$defs/sha256"},
        "effectiveConfigSha256": {"$ref": "#/$defs/sha256"},
        "configId": {"type": "string", "minLength": 1},
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceSha256", "annotationSha256", "referenceSha256"],
          "properties": {
            "sourceSha256": {"$ref": "#/$defs/sha256"},
            "annotationSha256": {"$ref": "#/$defs/sha256"},
            "referenceSha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signedRelativeRotationDeg", "unit", "confidence", "valid", "referenceFrame", "targetFrame", "positiveDirection"],
      "properties": {
        "signedRelativeRotationDeg": {"type": ["number", "null"], "minimum": -180, "exclusiveMaximum": 180},
        "unit": {"const": "deg"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "valid": {"type": "boolean"},
        "referenceFrame": {"type": "string", "minLength": 1},
        "targetFrame": {"type": "string", "minLength": 1},
        "positiveDirection": {"type": ["string", "null"], "enum": ["cw", "ccw", null]}
      }
    },
    "technicalStatus": {"enum": ["succeeded", "failed"]},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "stage"],
          "properties": {
            "code": {"enum": ["INPUT_INVALID", "ASSET_MISMATCH", "FACE_NOT_FOUND", "SLOT_NOT_FOUND", "SLOT_ROTATION_INCONSISTENT", "SLOT_FIT_FAILED", "SLOT_PAIR_NOT_FOUND", "SLOT_PAIR_AMBIGUOUS", "PHYSICAL_OUTER_CIRCLE_FAILED", "HOUSING_CIRCLE_NOT_FOUND", "HOUSING_CIRCLE_AMBIGUOUS", "GROOVE_RECOGNITION_FAILED", "GROOVE_RECOGNITION_AMBIGUOUS", "GROOVE_REFINEMENT_FAILED", "ROLE_ASSIGNMENT_FAILED", "ROLE_ASSIGNMENT_AMBIGUOUS", "RING_TRUNCATED", "QUALITY_REJECTED", "TARGET_SEMANTICS_UNCONFIRMED", "DATUM_DEFINITION_UNCONFIRMED", "FEATURE_MAPPING_UNCONFIRMED", "OUTPUT_PURPOSE_UNCONFIRMED", "POSE_CONVENTION_UNCONFIRMED", "PLC_MAPPING_UNCONFIRMED", "ANGLE_OUT_OF_RANGE", "INTERNAL_ERROR"]},
            "message": {"type": "string", "minLength": 1},
            "stage": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "diagnostics": {"type": "object"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "allOf": [
    {
      "if": {"properties": {"result": {"properties": {"valid": {"const": true}}}}},
      "then": {
        "properties": {
          "technicalStatus": {"const": "succeeded"},
          "error": {"type": "null"},
          "result": {"properties": {"signedRelativeRotationDeg": {"type": "number"}, "confidence": {"type": "number"}}}
        }
      },
      "else": {
        "properties": {
          "technicalStatus": {"const": "failed"},
          "error": {"type": "object"},
          "result": {"properties": {"signedRelativeRotationDeg": {"type": "null"}, "confidence": {"type": "null"}}}
        }
      }
    }
  ]
}
