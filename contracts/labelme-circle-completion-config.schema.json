{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "labelme-circle-completion-config/1",
  "title": "LabelMe partial-circle completion config",
  "type": "object",
  "required": [
    "schemaVersion",
    "inputLabel",
    "outputLabel",
    "minimumSourcePoints",
    "maximumMedianResidualPx",
    "minimumArcCoverageDeg",
    "maximumCompletedUniquePoints"
  ],
  "properties": {
    "schemaVersion": {"const": "labelme-circle-completion-config/1"},
    "inputLabel": {"type": "string", "minLength": 1},
    "outputLabel": {"type": "string", "minLength": 1},
    "minimumSourcePoints": {"type": "integer", "minimum": 8},
    "maximumMedianResidualPx": {"type": "number", "exclusiveMinimum": 0, "maximum": 25.0},
    "minimumArcCoverageDeg": {"type": "number", "exclusiveMinimum": 0, "maximum": 360},
    "maximumCompletedUniquePoints": {"type": "integer", "minimum": 8}
  },
  "additionalProperties": false
}
