{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a-end-face-short-line-comparison/1",
  "title": "137 A-End-Face Per-Image Short-Line Comparison v1",
  "type": "object",
  "required": ["schemaVersion", "taskId", "technicalStatus", "input", "provenance", "baselineSchemaVersion", "coreFeatureStatus", "features", "error"],
  "properties": {
    "schemaVersion": {"const": "a-end-face-short-line-comparison/1"},
    "taskId": {"type": "string", "minLength": 1},
    "technicalStatus": {"enum": ["compared", "baseline_failed"]},
    "input": {
      "type": "object",
      "required": ["relativePath", "sha256", "width", "height"],
      "properties": {
        "relativePath": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["coreSourceSha256", "candidateConfigSha256"],
      "properties": {
        "annotationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "referenceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coreSourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidateId": {"type": "string"},
        "candidateAlgorithmVersion": {"type": "string"},
        "candidateConfigSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidateReferenceMode": {"enum": ["desktop_core", "external_labelme"]},
        "candidateReferenceSchemaVersion": {"type": ["string", "null"], "enum": ["a-end-face-labelme-short-line-reference/1", null]},
        "candidateReferenceAnnotationSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "candidateReferenceImageSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "evaluationScope": {"enum": ["development_20", "unspecified"]},
        "developmentGroup": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["sampleId", "position", "imageCount"],
              "properties": {
                "sampleId": {"type": "string", "minLength": 1},
                "position": {"type": "string", "minLength": 1},
                "imageCount": {"const": 20}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "baselineSchemaVersion": {"enum": ["a-end-face-result/2", "a-end-face-result/3"]},
    "coreFeatureStatus": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["coreValid", "source", "reason"],
        "properties": {
          "coreValid": {"type": "boolean"},
          "source": {"type": ["string", "null"]},
          "reason": {"type": ["string", "null"]},
          "rawFeature": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "features": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/comparison"}}
      ]
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["code", "message"],
          "properties": {"code": {"const": "BASELINE_FAILED"}, "message": {"type": "string"}},
          "additionalProperties": false
        }
      ]
    }
  },
  "$defs": {
    "comparison": {
      "type": "object",
      "required": ["feature", "canonicalFeature", "candidateId", "algorithmVersion", "configSha256", "core", "candidate", "diagnostic", "transition"],
      "properties": {
        "feature": {"type": "string"},
        "canonicalFeature": {"enum": ["19", "30"]},
        "candidateId": {"type": "string"},
        "algorithmVersion": {"type": "string"},
        "configSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "core": {
          "type": "object",
          "required": ["coreValid", "source", "reason", "target", "reference", "fields"],
          "properties": {
            "coreValid": {"type": "boolean"}, "source": {"type": ["string", "null"]},
            "reason": {"type": ["string", "null"]}, "target": {"type": ["object", "null"]},
            "reference": {"type": ["object", "null"]}, "fields": {"type": "object"}
          },
          "additionalProperties": false
        },
        "candidate": {
          "type": "object",
          "required": ["candidateValid", "source", "target", "reference", "deltaFromCore", "elapsedMs"],
          "properties": {
            "candidateValid": {"type": "boolean"}, "source": {"type": "string"},
            "target": {"type": ["object", "null"]}, "reference": {"type": ["object", "null"]},
            "deltaFromCore": {"type": ["object", "null"]}, "elapsedMs": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "diagnostic": {
          "type": "object",
          "required": ["failedChecks", "failureCategories"],
          "properties": {
            "failedChecks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "failureCategories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": true
        },
        "transition": {"enum": ["both_valid", "recovered", "regressed", "both_invalid"]}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"technicalStatus": {"const": "compared"}}}, "then": {"properties": {"features": {"type": "object"}, "error": {"type": "null"}}}},
    {"if": {"properties": {"technicalStatus": {"const": "baseline_failed"}}}, "then": {"properties": {"features": {"type": "null"}, "error": {"type": "object"}}}}
  ],
  "additionalProperties": false
}
