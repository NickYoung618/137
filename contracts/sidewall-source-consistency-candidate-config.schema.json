{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/sidewall-source-consistency-candidate-config.schema.json",
  "title": "Sidewall source-consistency candidate config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "enabled", "threshold_version", "development_only", "max_endpoint_structure_difference"],
  "properties": {
    "schema_version": {"const": "sidewall-source-consistency-candidate/1"},
    "enabled": {"type": "boolean", "default": false},
    "threshold_version": {"type": "string", "minLength": 1},
    "development_only": {"const": true},
    "max_endpoint_structure_difference": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
