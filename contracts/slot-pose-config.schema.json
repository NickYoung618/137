  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixtureShadowTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id", "center_deg", "max_center_drift_deg", "half_width_deg",
        "max_half_width_delta_deg", "prominence_reference",
        "max_prominence_normalized_difference", "deficit_area_reference",
        "max_deficit_normalized_difference", "intensity_profile",
        "gradient_profile", "template_source", "human_verified"
      ],
      "properties": {
        "template_id": {"type": "string", "minLength": 1},
        "center_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
        "max_center_drift_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
        "half_width_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 90},
        "max_half_width_delta_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 90},
        "prominence_reference": {"type": "number", "exclusiveMinimum": 0},
        "max_prominence_normalized_difference": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "deficit_area_reference": {"type": "number", "exclusiveMinimum": 0},
        "max_deficit_normalized_difference": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "intensity_profile": {"type": "array", "maxItems": 129, "items": {"type": "number"}},
        "gradient_profile": {"type": "array", "maxItems": 129, "items": {"type": "number"}},
        "template_source": {"type": "string", "minLength": 1},
