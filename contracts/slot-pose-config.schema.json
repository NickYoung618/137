{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slot-pose-config.schema.json",
  "title": "A端面槽姿态配置",
  "type": "object",
  "required": ["schema_version", "project", "config_id", "legacy_asset", "pose", "detector"],
  "properties": {
    "schema_version": {"const": "slot-pose-config/1"},
    "project": {"const": "137-housing-slot-pose"},
    "config_id": {"type": "string", "minLength": 1},
    "legacy_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "annotation_path", "annotation_sha256", "reference_path", "reference_sha256"],
      "properties": {
        "source_mode": {"enum": ["external_file", "bundled_module"], "default": "external_file"},
        "source_path": {"type": "string", "minLength": 1},
        "bundled_module": {"const": "algorithms.end_face.core"},
        "upstream_source_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "annotation_path": {"type": "string", "minLength": 1},
        "annotation_sha256": {"$ref": "#/$defs/sha256"},
        "reference_path": {"type": "string", "minLength": 1},
        "reference_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"source_mode": {"const": "bundled_module"}},
            "required": ["source_mode"]
          },
          "then": {"required": ["bundled_module", "upstream_source_sha256"]},
          "else": {"required": ["source_path"]}
        }
      ]
    },
    "pose": {
      "type": "object",
      "required": ["reference_frame", "target_frame", "mechanical_zero_image_deg", "positive_direction", "conventions_confirmed", "valid_range_deg", "production_plc_mapping_confirmed"],
      "properties": {
        "reference_frame": {"type": "string", "minLength": 1},
        "target_frame": {"type": "string", "minLength": 1},
        "mechanical_zero_image_deg": {"type": ["number", "null"], "minimum": -180, "exclusiveMaximum": 180},
        "positive_direction": {"type": ["string", "null"], "enum": ["cw", "ccw", null]},
        "conventions_confirmed": {"type": "boolean"},
        "target_semantics_confirmed": {"type": "boolean", "default": false},
        "drawing_datum_definition_confirmed": {"type": "boolean", "default": false},
        "a2_drawing_feature_mapping_confirmed": {"type": "boolean", "default": false},
        "output_purpose": {"type": ["string", "null"], "enum": ["drawing_tolerance_inspection", "mechanical_correction", null]},
        "valid_range_deg": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "production_plc_mapping_confirmed": {"type": "boolean"}
      }
    },
    "detector": {
      "type": "object",
      "required": ["min_notch_prominence", "min_polar_score", "max_rotation_disagreement_deg", "min_scale", "max_scale"],
      "properties": {
        "diagnostic_mode": {"enum": ["legacy_single_notch", "paired_notches_centerline", "multi_notch_roles", "single_real_groove"], "default": "legacy_single_notch"},
        "face_search_roi_normalized": {
          "type": ["array", "null"],
          "description": "Optional alignment-only [x_min,y_min,x_max,y_max] ROI; absent or null means full frame.",
          "prefixItems": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "min_notch_prominence": {"type": "number", "minimum": 0},
        "min_polar_score": {"type": "number", "minimum": 0},
        "max_rotation_disagreement_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
        "min_scale": {"type": "number", "exclusiveMinimum": 0},
        "max_scale": {"type": "number", "exclusiveMinimum": 0},
        "max_polar_pair_disagreement_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
        "profile": {
          "type": "object",
          "required": ["n_angles", "n_radii", "shell_width_px", "smoothing_window", "mad_multiplier", "min_prominence", "min_half_width_deg", "max_half_width_deg"],
          "properties": {
            "n_angles": {"type": "integer", "minimum": 36},
            "n_radii": {"type": "integer", "minimum": 2},
            "shell_width_px": {"type": "number", "exclusiveMinimum": 0},
            "smoothing_window": {"type": "integer", "minimum": 1},
            "mad_multiplier": {"type": "number", "exclusiveMinimum": 0},
            "min_prominence": {"type": "number", "exclusiveMinimum": 0},
            "min_half_width_deg": {"type": "number", "exclusiveMinimum": 0},
            "max_half_width_deg": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "dark_candidate_robustness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "enabled", "quantile_levels", "max_hypotheses", "dedup_center_deg", "min_interval_overlap_ratio"],
          "properties": {
            "schema_version": {"const": "angular-dark-candidate-robustness/1"},
            "enabled": {"type": "boolean", "default": false},
            "quantile_levels": {
              "type": "array", "maxItems": 3, "uniqueItems": true,
              "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 0.5}
            },
            "max_hypotheses": {"type": "integer", "minimum": 1, "maximum": 4},
            "dedup_center_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
            "min_interval_overlap_ratio": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "fixture_shadow_model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version", "enabled", "coordinate_frame_id", "threshold_version",
            "profile_sample_count", "profile_window_half_width_deg",
            "pair_max_prominence_normalized_difference",
            "pair_max_deficit_normalized_difference", "pair_max_profile_mae",
            "enable_overlap_decomposition", "max_overlap_hypotheses",
            "min_residual_level", "min_residual_width_deg",
            "residual_dedup_center_deg", "templates"
          ],
          "properties": {
            "schema_version": {"const": "fixture-shadow-model/1"},
            "enabled": {"type": "boolean", "default": false},
            "coordinate_frame_id": {"const": "image-x-right-y-down-clockwise/1"},
            "threshold_version": {"type": "string", "minLength": 1},
            "profile_sample_count": {"type": "integer", "minimum": 9, "maximum": 129},
            "profile_window_half_width_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 90},
            "pair_max_prominence_normalized_difference": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "pair_max_deficit_normalized_difference": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "pair_max_profile_mae": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "enable_overlap_decomposition": {"type": "boolean", "default": false},
            "max_overlap_hypotheses": {"type": "integer", "minimum": 1, "maximum": 8},
            "min_residual_level": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "min_residual_width_deg": {"type": "number", "exclusiveMinimum": 0},
            "residual_dedup_center_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
            "templates": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "items": {"$ref": "#/$defs/fixtureShadowTemplate"}
            }
          },
          "allOf": [
            {
              "if": {"properties": {"enable_overlap_decomposition": {"const": true}}, "required": ["enable_overlap_decomposition"]},
              "then": {
                "properties": {
                  "templates": {
                    "items": {
                      "allOf": [
                        {"$ref": "#/$defs/fixtureShadowTemplate"},
                        {
                          "properties": {
                            "human_verified": {"const": true},
                            "intensity_profile": {"minItems": 9},
                            "gradient_profile": {"minItems": 9}
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "sidewall_source_consistency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version", "enabled", "threshold_version",
            "max_contrast_normalized_difference",
            "max_gradient_normalized_difference", "max_normalized_profile_mae",
            "min_normalized_profile_correlation",
            "max_radial_coverage_difference", "max_endpoint_structure_difference"
          ],
          "properties": {
            "schema_version": {"const": "groove-sidewall-source-consistency/1"},
            "enabled": {"type": "boolean", "default": false},
            "threshold_version": {"type": "string", "minLength": 1},
            "max_contrast_normalized_difference": {"type": "number", "minimum": 0, "maximum": 1},
            "max_gradient_normalized_difference": {"type": "number", "minimum": 0, "maximum": 1},
            "max_normalized_profile_mae": {"type": "number", "minimum": 0, "maximum": 1},
            "min_normalized_profile_correlation": {"type": "number", "minimum": 0, "maximum": 1},
            "max_radial_coverage_difference": {"type": "number", "minimum": 0, "maximum": 1},
            "max_endpoint_structure_difference": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "sidewall_source_consistency_candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "enabled", "threshold_version", "development_only", "max_endpoint_structure_difference"],
          "properties": {
            "schema_version": {"const": "sidewall-source-consistency-candidate/1"},
            "enabled": {"type": "boolean", "default": false},
            "threshold_version": {"type": "string", "minLength": 1},
            "development_only": {"const": true},
            "max_endpoint_structure_difference": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "source_consistency_adjudication": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["schema_version", "enabled", "threshold_version", "development_only", "max_endpoint_structure_difference"],
              "properties": {
                "schema_version": {"const": "source-consistency-adjudication/1"},
                "enabled": {"type": "boolean", "default": false},
                "threshold_version": {"type": "string", "minLength": 1},
                "development_only": {"const": true},
                "max_endpoint_structure_difference": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["schema_version", "enabled", "strategy_version", "development_only"],
              "properties": {
                "schema_version": {"const": "source-consistency-adjudication/2"},
                "enabled": {"type": "boolean", "default": false},
                "strategy_version": {"const": "locked-noncontrast-gates-v2"},
                "development_only": {"const": true}
              }
            }
          ]
        },
        "groove_recognition_recovery": {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "enabled", "strategy_version"],
          "properties": {
            "schema_version": {"const": "groove-recognition-recovery/1"},
            "enabled": {"type": "boolean", "default": false},
            "strategy_version": {"const": "exact-width-only-downstream-proof-v1"}
          }
        },
        "groove_recognition": {
          "type": "object",
          "properties": {
            "threshold_version": {"type": "string", "minLength": 1},
            "n_radii": {"type": "integer", "minimum": 16},
            "radial_span_px": {"type": "number", "exclusiveMinimum": 0},
            "shoulder_width_deg": {"type": "number", "exclusiveMinimum": 0},
            "shoulder_gap_deg": {"type": "number", "exclusiveMinimum": 0},
            "search_margin_deg": {"type": "number", "exclusiveMinimum": 0},
            "min_local_contrast": {"type": "number", "exclusiveMinimum": 0},
            "min_edge_contrast": {"type": "number", "exclusiveMinimum": 0},
            "min_radial_depth_px": {"type": "number", "exclusiveMinimum": 0},
            "min_radial_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "min_paired_edge_support": {"type": "number", "minimum": 0, "maximum": 1},
            "min_contour_continuity": {"type": "number", "minimum": 0, "maximum": 1},
            "max_width_coefficient_of_variation": {"type": "number", "minimum": 0, "maximum": 1},
            "max_center_drift_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "min_tangential_width_px": {"type": "number", "exclusiveMinimum": 0},
            "max_tangential_width_px": {"type": "number", "exclusiveMinimum": 0},
            "outer_connection_tolerance_px": {"type": "number", "exclusiveMinimum": 0},
            "max_gap_rows": {"type": "integer", "minimum": 0},
            "min_groove_score": {"type": "number", "minimum": 0, "maximum": 1},
            "ambiguity_margin": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "single_groove_pose": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema_version", "output_schema_version", "image_angle_schema_version", "expected_accepted_groove_count", "target"],
              "properties": {
                "schema_version": {"const": "single-real-groove-pose-config/1"},
                "output_schema_version": {"const": "slot-single-real-groove-pose/1"},
                "image_angle_schema_version": {"const": "slot-groove-image-angle/1"},
                "expected_accepted_groove_count": {"const": 1},
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schema_version", "nominal_deg", "expected_quadrant", "physical_datum_definition_id", "angle_convention_id"],
                  "properties": {
                    "schema_version": {"const": "slot-groove-target/1"},
                    "nominal_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
                    "expected_quadrant": {"enum": ["upper_left", "upper_right", "lower_left", "lower_right"]},
                    "physical_datum_definition_id": {"type": ["string", "null"], "minLength": 1},
                    "angle_convention_id": {"type": ["string", "null"], "minLength": 1}
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema_version", "output_schema_version", "image_angle_schema_version", "datum_angle_schema_version", "expected_accepted_groove_count", "target"],
              "properties": {
                "schema_version": {"const": "single-real-groove-pose-config/2"},
                "output_schema_version": {"const": "slot-single-real-groove-pose/2"},
                "image_angle_schema_version": {"const": "slot-groove-image-angle/2"},
                "datum_angle_schema_version": {"const": "slot-groove-y-down-angle/1"},
                "expected_accepted_groove_count": {"const": 1},
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schema_version", "nominal_deg", "tolerance_deg", "accepted_min_deg", "accepted_max_deg", "required_horizontal_position", "required_vertical_position", "physical_datum_definition_id", "angle_convention_id"],
                  "properties": {
                    "schema_version": {"const": "slot-groove-target/2"},
                    "nominal_deg": {"const": 85.0},
                    "tolerance_deg": {"const": 5.0},
                    "accepted_min_deg": {"const": 80.0},
                    "accepted_max_deg": {"const": 90.0},
                    "required_horizontal_position": {"const": "left"},
                    "required_vertical_position": {"const": "lower_or_axis"},
                    "physical_datum_definition_id": {"type": "string", "minLength": 1},
                    "angle_convention_id": {"type": "string", "minLength": 1}
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema_version", "output_schema_version", "image_angle_schema_version", "datum_angle_schema_version", "expected_accepted_groove_count", "target"],
              "properties": {
                "schema_version": {"const": "single-real-groove-pose-config/3"},
                "output_schema_version": {"const": "slot-single-real-groove-pose/3"},
                "image_angle_schema_version": {"const": "slot-groove-image-angle/2"},
                "datum_angle_schema_version": {"const": "slot-groove-y-down-angle/1"},
                "expected_accepted_groove_count": {"const": 1},
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schema_version", "nominal_deg", "tolerance_deg", "accepted_min_deg", "accepted_max_deg", "required_horizontal_position", "required_vertical_position", "physical_datum_definition_id", "angle_convention_id"],
                  "properties": {
                    "schema_version": {"const": "slot-groove-target/3"},
                    "nominal_deg": {"const": 85.0},
                    "tolerance_deg": {"const": 5.0},
                    "accepted_min_deg": {"const": 80.0},
                    "accepted_max_deg": {"const": 90.0},
                    "required_horizontal_position": {"const": "left"},
                    "required_vertical_position": {"const": "lower_or_axis"},
                    "physical_datum_definition_id": {"const": "detected-physical-circle-positive-y-down-ray/1"},
                    "angle_convention_id": {"const": "image-y-down-clockwise-signed/1"}
                  }
                }
              }
            }
          ]
        },
        "groove_refinement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold_version": {"enum": ["groove-sidewall-subpixel-v1", "groove-sidewall-subpixel-v2"]},
            "radial_inset_min_px": {"type": "number", "exclusiveMinimum": 0},
            "radial_inset_max_px": {"type": "number", "exclusiveMinimum": 0},
            "radial_sample_count": {"type": "integer", "minimum": 3},
            "tangential_search_margin_deg": {"type": "number", "exclusiveMinimum": 0},
            "tangential_sample_step_px": {"type": "number", "exclusiveMinimum": 0},
            "contrast_inner_offset_px": {"type": "number", "exclusiveMinimum": 0},
            "contrast_outer_offset_px": {"type": "number", "exclusiveMinimum": 0},
            "min_side_points": {"type": "integer", "minimum": 3},
            "min_edge_contrast": {"type": "number", "exclusiveMinimum": 0},
            "min_edge_gradient_per_px": {"type": "number", "exclusiveMinimum": 0},
            "max_line_residual_p95_px": {"type": "number", "exclusiveMinimum": 0},
            "max_intersection_coarse_delta_deg": {"type": "number", "exclusiveMinimum": 0},
            "allow_endpoint_reversal": {"type": "boolean"},
            "line_consensus_min_inlier_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "line_consensus_min_span_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "line_consensus_min_pair_separation_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "line_consensus_model_merge_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
            "line_consensus_min_support_margin": {"type": "integer", "minimum": 1},
            "line_consensus_max_refit_hypotheses": {"type": "integer", "minimum": 2, "maximum": 128},
            "wall_edge_family": {
              "type": "object", "additionalProperties": false,
              "required": ["schema_version", "enabled", "strategy_version", "max_peaks_per_row", "min_peak_separation_px", "max_hypotheses"],
              "properties": {
                "schema_version": {"const": "groove-wall-edge-family/1"},
                "enabled": {"type": "boolean", "default": false},
                "strategy_version": {"const": "bounded-cross-radius-wall-family-v1"},
                "max_peaks_per_row": {"type": "integer", "minimum": 2, "maximum": 8},
                "min_peak_separation_px": {"type": "number", "exclusiveMinimum": 0},
                "max_hypotheses": {"type": "integer", "minimum": 2, "maximum": 128}
              }
            }
          }
        },
        "ambiguity_resolution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {"const": "groove-ambiguity-resolution/1"},
            "enabled": {"type": "boolean", "default": false},
            "max_candidates": {"type": "integer", "minimum": 2, "maximum": 3, "default": 3}
          }
        },
        "groove_shadow_source_discrimination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "enabled", "strategy_version"],
          "properties": {
            "schema_version": {"enum": ["groove-shadow-source-discrimination/1", "groove-shadow-source-discrimination/2"]},
            "enabled": {"type": "boolean", "default": false},
            "strategy_version": {"enum": ["physical-sidewall-source-evidence/1", "fixture-role-u-contour-source-evidence/2"]}
          },
          "allOf": [
            {
              "if": {"properties": {"schema_version": {"const": "groove-shadow-source-discrimination/1"}}},
              "then": {"properties": {"strategy_version": {"const": "physical-sidewall-source-evidence/1"}}}
            },
            {
              "if": {"properties": {"schema_version": {"const": "groove-shadow-source-discrimination/2"}}},
              "then": {"properties": {"strategy_version": {"const": "fixture-role-u-contour-source-evidence/2"}}}
            }
          ]
        },
        "physical_outer_circle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold_version": {"type": "string", "minLength": 1},
            "n_angles": {"type": "integer", "minimum": 36},
            "min_edge_point_count": {"type": "integer", "minimum": 8},
            "inlier_residual_px": {"type": "number", "exclusiveMinimum": 0},
            "min_inlier_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "angular_bin_count": {"type": "integer", "minimum": 4},
            "min_angular_coverage": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "max_residual_p95_px": {"type": "number", "exclusiveMinimum": 0},
            "max_center_shift_px": {"type": "number", "exclusiveMinimum": 0},
            "min_radius_ratio": {"type": "number", "exclusiveMinimum": 0},
            "max_radius_ratio": {"type": "number", "exclusiveMinimum": 0},
            "sector_robustness": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema_version", "enabled", "sector_bin_count", "min_points_per_sector", "suspect_residual_p95_multiplier", "max_excluded_sector_count", "max_contiguous_excluded_deg", "min_retained_angular_coverage", "max_refit_center_delta_px", "max_refit_radius_delta_px"],
              "properties": {
                "schema_version": {"const": "physical-circle-sector-robustness/1"},
                "enabled": {"type": "boolean", "default": false},
                "sector_bin_count": {"type": "integer", "minimum": 4, "maximum": 72},
                "min_points_per_sector": {"type": "integer", "minimum": 1},
                "suspect_residual_p95_multiplier": {"type": "number", "minimum": 1},
                "max_excluded_sector_count": {"type": "integer", "minimum": 0, "maximum": 71},
                "max_contiguous_excluded_deg": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180},
                "min_retained_angular_coverage": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                "max_refit_center_delta_px": {"type": "number", "exclusiveMinimum": 0},
                "max_refit_radius_delta_px": {"type": "number", "exclusiveMinimum": 0}
              }
            },
            "edge_family_selection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version", "enabled", "strategy_version", "max_peaks_per_ray",
                "min_gradient", "min_separation_px", "min_background_persistence_ratio", "min_seed_votes",
                "max_seed_count", "max_hypotheses", "max_families", "refinement_iterations",
                "assignment_residual_px", "min_support_ratio", "min_angular_coverage",
                "max_preliminary_residual_p95_px", "dedup_center_px", "dedup_radius_px",
                "min_support_overlap_ratio", "min_assignment_overlap_ratio"
              ],
              "properties": {
                "schema_version": {"const": "physical-circle-edge-family-selection/1"},
                "enabled": {"type": "boolean", "default": false},
                "strategy_version": {"type": "string", "minLength": 1},
                "max_peaks_per_ray": {"type": "integer", "minimum": 1, "maximum": 8},
                "min_gradient": {"type": "number", "exclusiveMinimum": 0},
                "min_separation_px": {"type": "number", "exclusiveMinimum": 0},
                "min_background_persistence_ratio": {"type": "number", "minimum": 0, "maximum": 1},
                "min_seed_votes": {"type": "integer", "minimum": 1, "maximum": 72},
