{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slot-pose-config.schema.json",
  "title": "A端面槽姿态配置",
  "type": "object",
  "required": ["schema_version", "project", "config_id", "legacy_asset", "pose", "detector"],
  "properties": {
    "schema_version": {"const": "slot-pose-config/1"},
    "project": {"const": "137-housing-slot-pose"},
    "config_id": {"type": "string", "minLength": 1},
    "legacy_asset": {
      "type": "object",
      "required": ["source_path", "source_sha256", "annotation_path", "annotation_sha256", "reference_path", "reference_sha256"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "annotation_path": {"type": "string", "minLength": 1},
        "annotation_sha256": {"$ref": "#/$defs/sha256"},
        "reference_path": {"type": "string", "minLength": 1},
        "reference_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pose": {
      "type": "object",
      "required": ["reference_frame", "target_frame", "mechanical_zero_image_deg", "positive_direction", "conventions_confirmed", "valid_range_deg", "production_plc_mapping_confirmed"],
      "properties": {
        "reference_frame": {"type": "string", "minLength": 1},
        "target_frame": {"type": "string", "minLength": 1},
        "mechanical_zero_image_deg": {"type": ["number", "null"], "minimum": -180, "exclusiveMaximum": 180},
        "positive_direction": {"type": ["string", "null"], "enum": ["cw", "ccw", null]},
        "conventions_confirmed": {"type": "boolean"},
        "target_semantics_confirmed": {"type": "boolean", "default": false},
        "drawing_datum_definition_confirmed": {"type": "boolean", "default": false},
        "a2_drawing_feature_mapping_confirmed": {"type": "boolean", "default": false},
        "output_purpose": {"type": ["string", "null"], "enum": ["drawing_tolerance_inspection", "mechanical_correction", null]},
        "valid_range_deg": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "production_plc_mapping_confirmed": {"type": "boolean"}
      }
    },
    "detector": {
      "type": "object",
      "required": ["min_notch_prominence", "min_polar_score", "max_rotation_disagreement_deg", "min_scale", "max_scale"],
      "properties": {
        "diagnostic_mode": {"enum": ["legacy_single_notch", "paired_notches_centerline", "multi_notch_roles", "single_real_groove"], "default": "legacy_single_notch"},
        "face_search_roi_normalized": {
          "type": ["array", "null"],
          "description": "Optional alignment-only [x_min,y_min,x_max,y_max] ROI; absent or null means full frame.",
          "prefixItems": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "min_notch_prominence": {"type": "number", "minimum": 0},
        "min_polar_score": {"type": "number", "minimum": 0},
        "max_rotation_disagreement_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
        "min_scale": {"type": "number", "exclusiveMinimum": 0},
        "max_scale": {"type": "number", "exclusiveMinimum": 0},
        "max_polar_pair_disagreement_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
        "profile": {
          "type": "object",
          "required": ["n_angles", "n_radii", "shell_width_px", "smoothing_window", "mad_multiplier", "min_prominence", "min_half_width_deg", "max_half_width_deg"],
          "properties": {
            "n_angles": {"type": "integer", "minimum": 36},
            "n_radii": {"type": "integer", "minimum": 2},
            "shell_width_px": {"type": "number", "exclusiveMinimum": 0},
            "smoothing_window": {"type": "integer", "minimum": 1},
            "mad_multiplier": {"type": "number", "exclusiveMinimum": 0},
            "min_prominence": {"type": "number", "exclusiveMinimum": 0},
            "min_half_width_deg": {"type": "number", "exclusiveMinimum": 0},
            "max_half_width_deg": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "groove_recognition": {
          "type": "object",
          "required": ["threshold_version", "n_radii", "radial_span_px", "shoulder_width_deg", "shoulder_gap_deg", "search_margin_deg", "min_local_contrast", "min_edge_contrast", "min_radial_depth_px", "min_radial_depth_ratio", "min_paired_edge_support", "min_contour_continuity", "max_width_coefficient_of_variation", "max_center_drift_ratio", "min_tangential_width_px", "max_tangential_width_px", "outer_connection_tolerance_px", "max_gap_rows", "min_groove_score", "ambiguity_margin"],
          "properties": {
            "threshold_version": {"type": "string", "minLength": 1},
            "n_radii": {"type": "integer", "minimum": 16},
            "radial_span_px": {"type": "number", "exclusiveMinimum": 0},
            "shoulder_width_deg": {"type": "number", "exclusiveMinimum": 0},
            "shoulder_gap_deg": {"type": "number", "exclusiveMinimum": 0},
            "search_margin_deg": {"type": "number", "exclusiveMinimum": 0},
            "min_local_contrast": {"type": "number", "exclusiveMinimum": 0},
            "min_edge_contrast": {"type": "number", "exclusiveMinimum": 0},
            "min_radial_depth_px": {"type": "number", "exclusiveMinimum": 0},
            "min_radial_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "min_paired_edge_support": {"type": "number", "minimum": 0, "maximum": 1},
            "min_contour_continuity": {"type": "number", "minimum": 0, "maximum": 1},
            "max_width_coefficient_of_variation": {"type": "number", "minimum": 0, "maximum": 1},
            "max_center_drift_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "min_tangential_width_px": {"type": "number", "exclusiveMinimum": 0},
            "max_tangential_width_px": {"type": "number", "exclusiveMinimum": 0},
            "outer_connection_tolerance_px": {"type": "number", "exclusiveMinimum": 0},
            "max_gap_rows": {"type": "integer", "minimum": 0},
            "min_groove_score": {"type": "number", "minimum": 0, "maximum": 1},
            "ambiguity_margin": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "single_groove_pose": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema_version", "output_schema_version", "image_angle_schema_version", "expected_accepted_groove_count", "target"],
              "properties": {
                "schema_version": {"const": "single-real-groove-pose-config/1"},
                "output_schema_version": {"const": "slot-single-real-groove-pose/1"},
                "image_angle_schema_version": {"const": "slot-groove-image-angle/1"},
                "expected_accepted_groove_count": {"const": 1},
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schema_version", "nominal_deg", "expected_quadrant", "physical_datum_definition_id", "angle_convention_id"],
                  "properties": {
                    "schema_version": {"const": "slot-groove-target/1"},
                    "nominal_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
                    "expected_quadrant": {"enum": ["upper_left", "upper_right", "lower_left", "lower_right"]},
                    "physical_datum_definition_id": {"type": ["string", "null"], "minLength": 1},
                    "angle_convention_id": {"type": ["string", "null"], "minLength": 1}
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema_version", "output_schema_version", "image_angle_schema_version", "datum_angle_schema_version", "expected_accepted_groove_count", "target"],
              "properties": {
                "schema_version": {"const": "single-real-groove-pose-config/2"},
                "output_schema_version": {"const": "slot-single-real-groove-pose/2"},
                "image_angle_schema_version": {"const": "slot-groove-image-angle/2"},
                "datum_angle_schema_version": {"const": "slot-groove-y-down-angle/1"},
                "expected_accepted_groove_count": {"const": 1},
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schema_version", "nominal_deg", "tolerance_deg", "accepted_min_deg", "accepted_max_deg", "required_horizontal_position", "required_vertical_position", "physical_datum_definition_id", "angle_convention_id"],
                  "properties": {
                    "schema_version": {"const": "slot-groove-target/2"},
                    "nominal_deg": {"const": 85.0},
                    "tolerance_deg": {"const": 5.0},
                    "accepted_min_deg": {"const": 80.0},
                    "accepted_max_deg": {"const": 90.0},
                    "required_horizontal_position": {"const": "left"},
                    "required_vertical_position": {"const": "lower_or_axis"},
                    "physical_datum_definition_id": {"type": "string", "minLength": 1},
                    "angle_convention_id": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          ]
        },
        "groove_refinement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["threshold_version", "radial_inset_min_px", "radial_inset_max_px", "radial_sample_count", "tangential_search_margin_deg", "tangential_sample_step_px", "contrast_inner_offset_px", "contrast_outer_offset_px", "min_side_points", "min_edge_contrast", "min_edge_gradient_per_px", "max_line_residual_p95_px", "max_intersection_coarse_delta_deg", "allow_endpoint_reversal"],
          "properties": {
            "threshold_version": {"type": "string", "minLength": 1},
            "radial_inset_min_px": {"type": "number", "exclusiveMinimum": 0},
            "radial_inset_max_px": {"type": "number", "exclusiveMinimum": 0},
            "radial_sample_count": {"type": "integer", "minimum": 3},
            "tangential_search_margin_deg": {"type": "number", "exclusiveMinimum": 0},
            "tangential_sample_step_px": {"type": "number", "exclusiveMinimum": 0},
            "contrast_inner_offset_px": {"type": "number", "exclusiveMinimum": 0},
            "contrast_outer_offset_px": {"type": "number", "exclusiveMinimum": 0},
            "min_side_points": {"type": "integer", "minimum": 3},
            "min_edge_contrast": {"type": "number", "exclusiveMinimum": 0},
            "min_edge_gradient_per_px": {"type": "number", "exclusiveMinimum": 0},
            "max_line_residual_p95_px": {"type": "number", "exclusiveMinimum": 0},
            "max_intersection_coarse_delta_deg": {"type": "number", "exclusiveMinimum": 0},
            "allow_endpoint_reversal": {"type": "boolean"}
          }
        },
        "physical_outer_circle": {
          "type": "object",
          "required": ["threshold_version", "n_angles", "min_edge_point_count", "inlier_residual_px", "min_inlier_ratio", "angular_bin_count", "min_angular_coverage", "max_residual_p95_px", "max_center_shift_px", "min_radius_ratio", "max_radius_ratio"],
          "properties": {
            "threshold_version": {"type": "string", "minLength": 1},
            "n_angles": {"type": "integer", "minimum": 36},
            "min_edge_point_count": {"type": "integer", "minimum": 8},
            "inlier_residual_px": {"type": "number", "exclusiveMinimum": 0},
            "min_inlier_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "angular_bin_count": {"type": "integer", "minimum": 4},
            "min_angular_coverage": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "max_residual_p95_px": {"type": "number", "exclusiveMinimum": 0},
            "max_center_shift_px": {"type": "number", "exclusiveMinimum": 0},
            "min_radius_ratio": {"type": "number", "exclusiveMinimum": 0},
            "max_radius_ratio": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "full_frame_circle_locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "enabled"],
          "properties": {
            "schema_version": {"const": "full-frame-circle-locator/1"},
            "enabled": {"type": "boolean"},
            "strategy_version": {"type": "string", "minLength": 1},
            "downsample_factor": {"type": "integer", "minimum": 2},
            "threshold_offsets": {
              "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
              "items": {"type": "integer", "minimum": -64, "maximum": 64}
            },
            "allowed_center_normalized": {
              "type": "array", "minItems": 4, "maxItems": 4,
              "items": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "min_radius_to_min_image_dim": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.75},
            "max_radius_to_min_image_dim": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.75},
            "min_component_area_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "min_bbox_aspect_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "min_fill_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "max_fill_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "allow_border_contact": {"type": "boolean"},
            "min_border_clearance_ratio": {"type": "number", "minimum": 0},
            "max_coarse_candidates": {"type": "integer", "minimum": 1},
            "proposal_dedup_center_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "proposal_dedup_radius_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "physical_dedup_center_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "physical_dedup_radius_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "sparse_n_angles": {"type": "integer", "minimum": 36},
            "sparse_min_edge_point_count": {"type": "integer", "minimum": 8},
            "sparse_angular_bin_count": {"type": "integer", "minimum": 4},
            "selection_min_score_margin": {"type": "number", "minimum": 0, "maximum": 1},
            "score_weights": {
              "type": "object",
              "additionalProperties": false,
              "required": ["inlier", "coverage", "residual", "prior"],
              "properties": {
                "inlier": {"type": "number", "minimum": 0, "maximum": 1},
                "coverage": {"type": "number", "minimum": 0, "maximum": 1},
                "residual": {"type": "number", "minimum": 0, "maximum": 1},
                "prior": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        },
        "pairing": {
          "type": "object",
          "required": ["min_candidates", "max_candidates", "min_separation_deg", "max_separation_deg", "expected_separation_deg", "min_width_ratio", "min_prominence_ratio", "min_pair_score", "min_score_margin"],
          "properties": {
            "min_candidates": {"type": "integer", "minimum": 2},
            "max_candidates": {"type": "integer", "minimum": 2},
            "min_separation_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
            "max_separation_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
            "expected_separation_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
            "min_width_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "min_prominence_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "min_pair_score": {"type": "number", "minimum": 0, "maximum": 1},
            "min_score_margin": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "role_assignment": {
          "type": "object",
          "required": ["datum_definition", "assignments", "min_score_margin", "max_opposition_error_deg"],
          "properties": {
            "datum_definition": {"enum": ["single_candidate_ray", "opposed_candidates_axis"]},
            "min_score_margin": {"type": "number", "minimum": 0, "maximum": 1},
            "max_opposition_error_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
            "drawing_nominal_angle_deg": {"type": ["number", "null"], "minimum": 0, "maximum": 180},
            "drawing_tolerance_deg": {"type": ["number", "null"], "minimum": 0},
            "assignments": {
              "type": "object",
              "required": ["datum_primary", "target_left"],
              "additionalProperties": {"$ref": "#/$defs/roleRule"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "roleRule": {
      "type": "object",
      "required": ["expected_reference_azimuth_deg", "max_deviation_deg"],
      "properties": {
        "expected_reference_azimuth_deg": {"type": "number"},
        "max_deviation_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"detector": {"properties": {"diagnostic_mode": {"const": "multi_notch_roles"}}}}},
      "then": {"properties": {"detector": {"required": ["profile", "physical_outer_circle", "role_assignment"]}}}
    },
    {
      "if": {"properties": {"detector": {"properties": {"diagnostic_mode": {"const": "single_real_groove"}}}}},
      "then": {"properties": {"detector": {"required": ["profile", "physical_outer_circle", "groove_recognition", "single_groove_pose"]}}}
    },
    {
      "if": {
        "properties": {
          "detector": {
            "required": ["full_frame_circle_locator"],
            "properties": {
              "full_frame_circle_locator": {
                "required": ["enabled"],
                "properties": {"enabled": {"const": true}}
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "detector": {
            "properties": {
              "diagnostic_mode": {"const": "single_real_groove"},
              "face_search_roi_normalized": {"type": "null"}
            }
          }
        }
      }
    }
  ]
}
