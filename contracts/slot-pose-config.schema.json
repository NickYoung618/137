              "properties": {
                "inlier": {"type": "number", "minimum": 0, "maximum": 1},
                "coverage": {"type": "number", "minimum": 0, "maximum": 1},
                "residual": {"type": "number", "minimum": 0, "maximum": 1},
                "prior": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
