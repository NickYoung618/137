{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"half-turn-guidance-config.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","enabled","developmentOnly","authoritative","posePromotionAllowed","thresholdVersion","maxCandidatesPerFrame","maxMatchResidualDeg","minMatchMarginDeg","maxHalfWidthNormalizedDifference","maxProminenceNormalizedDifference","maxDeficitAreaNormalizedDifference","maxProfileNormalizedMae","targetAngleDeg","toleranceDeg"],
  "properties":{
    "schemaVersion":{"const":"half-turn-guidance-config/1"},"enabled":{"type":"boolean"},
    "developmentOnly":{"const":true},"authoritative":{"const":false},"posePromotionAllowed":{"const":false},
    "thresholdVersion":{"type":"string","minLength":1},"maxCandidatesPerFrame":{"type":"integer","minimum":1,"maximum":64},
    "maxMatchResidualDeg":{"type":"number","exclusiveMinimum":0,"maximum":180},"minMatchMarginDeg":{"type":"number","exclusiveMinimum":0,"maximum":180},
    "maxHalfWidthNormalizedDifference":{"type":"number","minimum":0,"maximum":1},"maxProminenceNormalizedDifference":{"type":"number","minimum":0,"maximum":1},
    "maxDeficitAreaNormalizedDifference":{"type":"number","minimum":0,"maximum":1},"maxProfileNormalizedMae":{"type":"number","minimum":0,"maximum":1},
    "targetAngleDeg":{"const":85.0},"toleranceDeg":{"const":5.0}
  }
}
