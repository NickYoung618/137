{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-second-wall-diagnostic-result.schema.json",
  "title": "局部第二侧壁实验诊断输出",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "thresholdVersion", "enabled", "status", "failureStage", "errorCode", "authoritative",
    "posePromotionAllowed", "anchorEvidence", "searchDomains", "sideSearchCandidates", "sideSearchMergeClusters",
    "searchOutcomeSummary", "rawHypotheses", "hypothesisMergeClusters", "hypotheses", "experimentalCandidate"
  ],
  "properties": {
    "schemaVersion": {"const": "local-second-wall-diagnostic/3"},
    "thresholdVersion": {"type": "string", "minLength": 1},
    "enabled": {"type": "boolean"},
    "status": {"enum": [
      "DISABLED", "NOT_EVALUATED", "LOCAL_SECOND_WALL_NOT_FOUND",
      "MULTIPLE_LOCAL_OPENINGS", "SOURCE_INCONSISTENT", "UNIQUE_DIAGNOSTIC"
    ]},
    "failureStage": {"type": ["string", "null"]},
    "errorCode": {
      "enum": [null, "CANDIDATE_MISSING", "LOCAL_SECOND_WALL_NOT_FOUND", "MULTIPLE_LOCAL_OPENINGS", "SOURCE_INCONSISTENT"]
    },
    "authoritative": {"const": false},
    "posePromotionAllowed": {"const": false},
    "coarseCandidateId": {"type": ["string", "null"]},
    "localInterval": {"type": "object", "additionalProperties": true},
    "anchorSides": {"type": "array", "items": {"enum": ["startSide", "endSide"]}},
    "anchorEvidence": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "searchDomains": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "domainId", "anchorSide", "direction", "signedDirection", "startDeg", "endDeg",
          "spanDeg", "wrapsBoundary", "seedCount", "seedAnglesDeg", "physicalLimitDeg", "source"
        ],
        "properties": {
          "domainId": {"type": "string", "minLength": 1},
          "anchorSide": {"enum": ["startSide", "endSide"]},
          "direction": {"enum": ["INWARD", "OUTWARD"]},
          "signedDirection": {"enum": [-1, 1]},
          "startDeg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
          "endDeg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
          "spanDeg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
          "wrapsBoundary": {"type": "boolean"},
          "seedCount": {"type": "integer", "minimum": 2},
          "seedAnglesDeg": {"type": "array", "minItems": 2, "items": {"type": "number", "minimum": 0, "exclusiveMaximum": 360}},
          "physicalLimitDeg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
          "source": {"const": "untrusted_coarse_endpoint"}
        }
      }
    },
    "searchLimits": {"type": "object", "additionalProperties": true},
    "initialPairEvidence": {"type": "object", "additionalProperties": true},
    "sideSearchCandidates": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": true,
        "required": [
          "searchCandidateId", "searchDomainId", "searchDirection", "searchAnchorSide", "seedIndexWithinDomain",
          "seedDeg", "searchWindowDeg", "polarity", "searchStatus",
          "rejectionStage", "fitToSeedDeltaDeg", "line", "lineSegment", "failedChecks",
          "mergeClusterId", "mergeDisposition"
        ],
        "properties": {
          "searchCandidateId": {"type": "string", "minLength": 1},
          "searchDomainId": {"type": "string", "minLength": 1},
          "searchDirection": {"enum": ["INWARD", "OUTWARD"]},
          "searchAnchorSide": {"enum": ["startSide", "endSide"]},
          "seedIndexWithinDomain": {"type": "integer", "minimum": 1},
          "seedDeg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
          "polarity": {"enum": ["falling", "rising"]},
          "searchStatus": {"type": "string", "minLength": 1},
          "searchWindowDeg": {"type": "object"},
          "rejectionStage": {"type": ["string", "null"]},
          "fitToSeedDeltaDeg": {"type": ["number", "null"]},
          "line": {"type": ["object", "null"]},
          "lineSegment": {"type": ["object", "null"]},
          "mergeClusterId": {"type": ["string", "null"]},
          "mergeDisposition": {"type": "string"},
          "failedChecks": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "sideSearchMergeClusters": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": true,
        "required": [
          "clusterId", "polarity", "representativeSearchCandidateId",
          "memberSearchCandidateIds", "suppressedSearchCandidateIds", "memberCount",
          "mergeThresholdDeg", "selectionRule"
        ]
      }
    },
    "searchOutcomeSummary": {"type": "object", "additionalProperties": {"type": "object"}},
    "rawHypotheses": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "hypothesisMergeClusters": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": true,
        "required": [
          "clusterId", "representativeRawHypothesisId", "memberRawHypothesisIds",
          "suppressedRawHypothesisIds", "memberCount", "mergeThresholdDeg", "selectionRule"
        ]
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": true,
        "required": ["hypothesisId", "checks", "failedChecks", "passed", "score"],
        "properties": {
          "hypothesisId": {"type": "string", "minLength": 1},
          "checks": {"type": "array"},
          "failedChecks": {"type": "array", "items": {"type": "string"}},
          "passed": {"type": "boolean"},
          "score": {"type": "number"}
        }
      }
    },
    "canonicalWallPairs": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "experimentalCandidate": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": [
            "hypothesisId", "canonicalPairId", "wallClusterIds", "wallCandidates",
            "openingEndpointProfileDeg", "openingWidthDeg",
            "authoritative", "posePromotionAllowed"
          ],
          "properties": {
            "hypothesisId": {"type": "string", "minLength": 1},
            "canonicalPairId": {"type": "string", "minLength": 1},
            "wallClusterIds": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
            "wallCandidates": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": true}},
            "openingEndpointProfileDeg": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "items": {"type": "number", "minimum": 0, "exclusiveMaximum": 360}
            },
            "openingWidthDeg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
            "authoritative": {"const": false},
            "posePromotionAllowed": {"const": false}
          }
        }
      ]
    },
    "passedHypothesisCount": {"type": "integer", "minimum": 0},
    "failedChecks": {"type": "array", "items": {"type": "string"}}
  }
}
