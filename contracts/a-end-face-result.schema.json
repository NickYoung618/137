{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a-end-face-result/3",
  "title": "137 A-End-Face Inspection Result v3",
  "type": "object",
  "required": ["schemaVersion", "taskId", "technicalStatus", "execution", "input", "algorithm", "result", "error"],
  "properties": {
    "schemaVersion": {"const": "a-end-face-result/3"},
    "taskId": {"type": "string", "minLength": 1},
    "technicalStatus": {"enum": ["succeeded", "failed"]},
    "execution": {
      "type": "object",
      "required": ["elapsedMs"],
      "properties": {"elapsedMs": {"type": "number", "minimum": 0}},
      "additionalProperties": false
    },
    "input": {"type": "object"},
    "algorithm": {
      "type": "object",
      "required": ["name", "version", "coreSourceSha256", "qualityPolicy", "shortLineCandidate"],
      "properties": {
        "name": {"const": "desktop-a-end-face-core"},
        "version": {"type": "string", "minLength": 1},
        "coreSourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "qualityPolicy": {
          "type": "object",
          "required": ["policyId", "sha256"],
          "properties": {
            "policyId": {"type": ["string", "null"]},
            "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "shortLineCandidate": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["candidateId", "algorithmVersion", "configSha256", "configPath"],
              "properties": {
                "candidateId": {"enum": ["reference-gradient-registration-v1", "main-housing-registration-v2"]},
                "algorithmVersion": {"type": "string", "minLength": 1},
                "configSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "configPath": {"type": ["string", "null"]},
                "referenceMode": {"enum": ["desktop_core", "external_labelme"]},
                "referenceSchemaVersion": {"type": ["string", "null"], "enum": ["a-end-face-labelme-short-line-reference/1", null]},
                "referenceAnnotationPath": {"type": ["string", "null"]},
                "referenceAnnotationSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                "referenceImagePath": {"type": ["string", "null"]},
                "referenceImageSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "result": {"oneOf": [{"$ref": "#/$defs/successResult"}, {"type": "null"}]},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["code", "message"],
          "properties": {"code": {"const": "DETECTION_FAILED"}, "message": {"type": "string"}},
          "additionalProperties": false
        }
      ]
    }
  },
  "$defs": {
    "geometry": {
      "type": "object",
      "required": ["x1", "y1", "x2", "y2", "length", "angleDeg"],
      "properties": {
        "x1": {"type": "number"}, "y1": {"type": "number"},
        "x2": {"type": "number"}, "y2": {"type": "number"},
        "length": {"type": "number", "minimum": 0}, "angleDeg": {"type": "number"}
      },
      "additionalProperties": false
    },
    "featureComparison": {
      "type": "object",
      "required": ["feature", "canonicalFeature", "candidateId", "algorithmVersion", "configSha256", "core", "candidate", "diagnostic", "transition"],
      "properties": {
        "feature": {"type": "string", "minLength": 1},
        "canonicalFeature": {"enum": ["19", "30"]},
        "candidateId": {"enum": ["reference-gradient-registration-v1", "main-housing-registration-v2"]},
        "algorithmVersion": {"type": "string", "minLength": 1},
        "configSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "core": {
          "type": "object",
          "required": ["coreValid", "source", "reason", "target", "reference", "fields"],
          "properties": {
            "coreValid": {"type": "boolean"},
            "source": {"type": ["string", "null"]},
            "reason": {"type": ["string", "null"]},
            "target": {"oneOf": [{"$ref": "#/$defs/geometry"}, {"type": "null"}]},
            "reference": {"oneOf": [{"$ref": "#/$defs/geometry"}, {"type": "null"}]},
            "fields": {"type": "object"}
          },
          "additionalProperties": false
        },
        "candidate": {
          "type": "object",
          "required": ["candidateValid", "source", "target", "reference", "deltaFromCore", "elapsedMs"],
          "properties": {
            "candidateValid": {"type": "boolean"},
            "source": {"enum": ["reference-gradient-registration-v1", "main-housing-registration-v2"]},
            "target": {"oneOf": [{"$ref": "#/$defs/geometry"}, {"type": "null"}]},
            "reference": {"oneOf": [{"$ref": "#/$defs/geometry"}, {"type": "null"}]},
            "deltaFromCore": {"type": ["object", "null"]},
            "elapsedMs": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "diagnostic": {
          "type": "object",
          "required": ["diagnosticVersion", "feature", "canonicalFeature", "roi", "coreSearch", "candidateSearch", "checks", "failedChecks", "failureCategories"],
          "properties": {
            "diagnosticVersion": {"const": "short-line-diagnostic/1"},
            "feature": {"type": "string"},
            "canonicalFeature": {"enum": ["19", "30"]},
            "roi": {"type": "object"},
            "coreSearch": {"type": "object"},
            "candidateSearch": {"type": "object"},
            "checks": {"type": "array", "items": {"type": "object"}},
            "failedChecks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "failureCategories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "transition": {"enum": ["both_valid", "recovered", "regressed", "both_invalid"]}
      },
      "additionalProperties": false
    },
    "successResult": {
      "type": "object",
      "required": ["valid", "pixelSize", "shiftMethod", "localization", "measurementCompleteness", "featureQuality", "measurements", "shortLineCandidates"],
      "properties": {
        "valid": {"type": "boolean"},
        "pixelSize": {"type": "number", "exclusiveMinimum": 0},
        "shiftMethod": {"type": "string"},
        "localization": {
          "type": "object",
          "required": ["valid", "policyId", "policySha256", "policyPath", "checks", "failedChecks"],
          "properties": {
            "valid": {"type": "boolean"}, "policyId": {"type": "string"},
            "policySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "policyPath": {"type": ["string", "null"]},
            "checks": {"type": "array", "items": {"type": "object"}},
            "failedChecks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "measurementCompleteness": {
          "type": "object",
          "required": ["allValid", "total", "validCount", "invalidCount", "invalidFeatures"],
          "properties": {
            "allValid": {"type": "boolean"}, "total": {"type": "integer", "minimum": 0},
            "validCount": {"type": "integer", "minimum": 0}, "invalidCount": {"type": "integer", "minimum": 0},
            "invalidFeatures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "featureQuality": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["feature", "canonicalFeature", "classification", "coreValid", "source", "reason", "fields", "diagnostic"],
            "properties": {
              "feature": {"type": "string"}, "canonicalFeature": {"type": "string", "minLength": 1},
              "classification": {"enum": ["feature_measurement", "localization_required"]},
              "coreValid": {"type": "boolean"}, "source": {"type": ["string", "null"]},
              "reason": {"type": ["string", "null"]}, "fields": {"type": "object"}, "diagnostic": {"type": "object"}
            },
            "additionalProperties": false
          }
        },
        "measurements": {"type": "object"},
        "shortLineCandidates": {"type": "object", "additionalProperties": {"$ref": "#/$defs/featureComparison"}}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"technicalStatus": {"const": "succeeded"}}}, "then": {"properties": {"result": {"$ref": "#/$defs/successResult"}, "error": {"type": "null"}}}},
    {"if": {"properties": {"technicalStatus": {"const": "failed"}}}, "then": {"properties": {"result": {"type": "null"}, "error": {"type": "object"}}}}
  ],
  "additionalProperties": false
}
