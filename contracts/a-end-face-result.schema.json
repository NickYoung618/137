{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a-end-face-result/1",
  "title": "137 A-End-Face Inspection Result",
  "type": "object",
  "required": ["schemaVersion", "taskId", "technicalStatus", "input", "algorithm", "result", "error"],
  "properties": {
    "schemaVersion": {"const": "a-end-face-result/1"},
    "taskId": {"type": "string", "minLength": 1},
    "technicalStatus": {"enum": ["succeeded", "failed"]},
    "input": {"type": "object"},
    "algorithm": {
      "type": "object",
      "required": ["name", "version", "coreSourceSha256"],
      "properties": {
        "name": {"const": "desktop-a-end-face-core"},
        "version": {"type": "string"},
        "coreSourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "required": ["valid", "pixelSize", "shiftMethod", "invalidFeatures", "measurements"],
          "properties": {
            "valid": {"type": "boolean"},
            "pixelSize": {"type": "number", "exclusiveMinimum": 0},
            "shiftMethod": {"type": "string"},
            "invalidFeatures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "measurements": {"type": "object"}
          },
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {"const": "DETECTION_FAILED"},
            "message": {"type": "string"}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"technicalStatus": {"const": "succeeded"}}},
      "then": {"properties": {"result": {"type": "object"}, "error": {"type": "null"}}}
    },
    {
      "if": {"properties": {"technicalStatus": {"const": "failed"}}},
      "then": {"properties": {"result": {"type": "null"}, "error": {"type": "object"}}}
    }
  ],
  "additionalProperties": false
}
