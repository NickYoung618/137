{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slot-pose-result/3",
  "title": "A-face single real-groove closed-loop guidance result v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "createdAtUtc", "image", "algorithm", "result", "technicalStatus", "error", "diagnostics"],
  "properties": {
    "schemaVersion": {"const": "slot-pose-result/3"},
    "taskId": {"type": "string", "minLength": 1},
    "createdAtUtc": {"type": "string", "format": "date-time"},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "format", "width", "height", "mode"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "format": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "mode": {"type": "string", "minLength": 1}
      }
    },
    "algorithm": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "configSha256", "configId", "assets"],
      "properties": {
        "name": {"const": "legacy-a-end-face-slot-pose-adapter"},
        "version": {"type": "string", "minLength": 1},
        "configSha256": {"$ref": "#/$defs/sha256"},
        "configId": {"type": "string", "minLength": 1},
        "assets": {
          "type": "object", "additionalProperties": false,
          "required": ["sourceSha256", "annotationSha256", "referenceSha256"],
          "properties": {
            "sourceSha256": {"$ref": "#/$defs/sha256"},
            "annotationSha256": {"$ref": "#/$defs/sha256"},
            "referenceSha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["signedRelativeRotationDeg", "unit", "confidence", "valid", "referenceFrame", "targetFrame", "positiveDirection", "detectionStatus", "guidanceStatus", "currentAngleDeg", "targetAngleDeg", "toleranceDeg", "correctionRawDeg", "correctionDeg", "imageFrameCorrectionDeg", "rotationDirection", "withinTolerance", "mechanicalCorrectionDeg", "plcCommand", "plcExecutionStatus", "plcExecutionAuthoritative", "plcBlockers"],
      "properties": {
        "signedRelativeRotationDeg": {"type": ["number", "null"], "minimum": -180, "exclusiveMaximum": 180},
        "unit": {"const": "deg"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "valid": {"type": "boolean"},
        "referenceFrame": {"const": "DETECTED_PHYSICAL_OUTER_CIRCLE_POSITIVE_Y_DOWN"},
        "targetFrame": {"const": "IMAGE_FRAME_TARGET_85_DEG"},
        "positiveDirection": {"const": "cw"},
        "detectionStatus": {"enum": ["DETECTED", "DETECTION_FAILED"]},
        "guidanceStatus": {"enum": ["DETECTED_NEEDS_ADJUSTMENT", "DETECTED_IN_POSITION", "NOT_AVAILABLE"]},
        "currentAngleDeg": {"type": ["number", "null"], "minimum": -180, "exclusiveMaximum": 180},
        "targetAngleDeg": {"const": 85.0},
        "toleranceDeg": {"const": 5.0},
        "correctionRawDeg": {"type": ["number", "null"], "minimum": -180, "exclusiveMaximum": 180},
        "correctionDeg": {"type": ["number", "null"], "minimum": -180, "exclusiveMaximum": 180},
        "imageFrameCorrectionDeg": {"type": ["number", "null"], "minimum": -180, "exclusiveMaximum": 180},
        "rotationDirection": {"enum": ["CLOCKWISE", "COUNTERCLOCKWISE", "NONE", null]},
        "withinTolerance": {"type": ["boolean", "null"]},
        "mechanicalCorrectionDeg": {"type": ["number", "null"], "minimum": -180, "exclusiveMaximum": 180},
        "plcCommand": {"type": "null"},
        "plcExecutionStatus": {"enum": ["BLOCKED_MAPPING_UNCONFIRMED", "READY"]},
        "plcExecutionAuthoritative": {"type": "boolean"},
        "plcBlockers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "technicalStatus": {"enum": ["succeeded", "failed"]},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["code", "message", "stage"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "stage": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "diagnostics": {"type": "object"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "allOf": [
    {
      "if": {"properties": {"result": {"properties": {"valid": {"const": true}}}}},
      "then": {
        "properties": {
          "technicalStatus": {"const": "succeeded"},
          "error": {"type": "null"},
          "result": {
            "properties": {
              "signedRelativeRotationDeg": {"type": "number"},
              "confidence": {"type": "number"},
              "detectionStatus": {"const": "DETECTED"},
              "guidanceStatus": {"enum": ["DETECTED_NEEDS_ADJUSTMENT", "DETECTED_IN_POSITION"]},
              "currentAngleDeg": {"type": "number"},
              "correctionRawDeg": {"type": "number"},
              "correctionDeg": {"type": "number"},
              "imageFrameCorrectionDeg": {"type": "number"},
              "rotationDirection": {"enum": ["CLOCKWISE", "COUNTERCLOCKWISE", "NONE"]},
              "withinTolerance": {"type": "boolean"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "technicalStatus": {"const": "failed"},
          "error": {"type": "object"},
          "result": {
            "properties": {
              "signedRelativeRotationDeg": {"type": "null"},
              "confidence": {"type": "null"},
              "detectionStatus": {"const": "DETECTION_FAILED"},
              "guidanceStatus": {"const": "NOT_AVAILABLE"},
              "currentAngleDeg": {"type": "null"},
              "correctionRawDeg": {"type": "null"},
              "correctionDeg": {"type": "null"},
              "imageFrameCorrectionDeg": {"type": "null"},
              "rotationDirection": {"type": "null"},
              "withinTolerance": {"type": "null"}
            }
          }
        }
      }
    }
  ]
}
