{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a2-robustness-audit/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "methodVersion", "accuracyEvaluated", "linesScanned", "targetRecordsParsed", "sealedRecordsParsed", "duplicateTargetRecordCount", "targetImageCount", "matchedUniqueImageCount", "elapsedMs", "groups", "limitations"],
  "properties": {
    "schemaVersion": {"const": "a2-robustness-audit/1"},
    "methodVersion": {"const": "target-sha-stream-audit/1"},
    "accuracyEvaluated": {"const": false},
    "linesScanned": {"type": "integer", "minimum": 0},
    "targetRecordsParsed": {"type": "integer", "minimum": 0},
    "sealedRecordsParsed": {"const": 0},
    "duplicateTargetRecordCount": {"type": "integer", "minimum": 0},
    "targetImageCount": {"type": "integer", "minimum": 1},
    "matchedUniqueImageCount": {"type": "integer", "minimum": 0},
    "elapsedMs": {"type": "number", "minimum": 0, "maximum": 5000},
    "groups": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/group"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "summary": {"type": "object", "additionalProperties": false, "required": ["count", "min", "median", "p95", "max"], "properties": {"count": {"type": "integer", "minimum": 0}, "min": {"type": ["number", "null"]}, "median": {"type": ["number", "null"]}, "p95": {"type": ["number", "null"]}, "max": {"type": ["number", "null"]}}},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "group": {"type": "object", "additionalProperties": false, "required": ["sampleId", "failureFamily", "expectedImageCount", "recordCount", "missingRecordCount", "errorCodeCounts", "stageFunnel", "rawCandidateCount", "acceptedGrooveCount", "circleResidualP95Px", "circleResidualMarginPx", "grooveRejectionReasonCounts"], "properties": {
      "sampleId": {"type": "string", "minLength": 1},
      "failureFamily": {"type": "string", "minLength": 1},
      "expectedImageCount": {"type": "integer", "minimum": 1},
      "recordCount": {"type": "integer", "minimum": 0},
      "missingRecordCount": {"type": "integer", "minimum": 0},
      "errorCodeCounts": {"$ref": "#/$defs/counts"},
      "stageFunnel": {"$ref": "#/$defs/counts"},
      "rawCandidateCount": {"$ref": "#/$defs/summary"},
      "acceptedGrooveCount": {"$ref": "#/$defs/summary"},
      "circleResidualP95Px": {"$ref": "#/$defs/summary"},
      "circleResidualMarginPx": {"$ref": "#/$defs/summary"},
      "grooveRejectionReasonCounts": {"$ref": "#/$defs/counts"}
    }}
  }
}
