{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "half-turn-guidance-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "requests"],
  "properties": {
    "schemaVersion": {"const": "half-turn-guidance-request/1"},
    "datasetId": {"type": "string", "minLength": 1},
    "requests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/request"}}
  },
  "$defs": {
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captureIndex", "relativePath", "imageSha256"],
      "properties": {
        "captureIndex": {"enum": [1, 2]},
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/|\\\\|[A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
        },
        "imageSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "halfTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nominalRotationDeg", "directionRequired", "executionResponsibility", "conventionId"],
      "properties": {
        "nominalRotationDeg": {"const": 180.0},
        "directionRequired": {"const": false},
        "executionResponsibility": {"const": "EXTERNAL_HARDWARE"},
        "conventionId": {"const": "image-x-right-y-down-clockwise/1"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "sampleId", "mode", "captures", "halfTurn"],
      "properties": {
        "requestId": {"type": "string", "minLength": 1},
        "sampleId": {"type": "string", "minLength": 1},
        "mode": {"enum": ["SINGLE_CAPTURE", "HALF_TURN_PAIR"]},
        "captures": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/capture"}},
        "halfTurn": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/halfTurn"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "SINGLE_CAPTURE"}}, "required": ["mode"]},
          "then": {
            "properties": {
              "captures": {
                "minItems": 1,
                "maxItems": 1,
                "contains": {"type": "object", "properties": {"captureIndex": {"const": 1}}, "required": ["captureIndex"]},
                "minContains": 1,
                "maxContains": 1
              },
              "halfTurn": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"mode": {"const": "HALF_TURN_PAIR"}}, "required": ["mode"]},
          "then": {
            "properties": {
              "captures": {
                "minItems": 2,
                "maxItems": 2,
                "allOf": [
                  {
                    "contains": {"type": "object", "properties": {"captureIndex": {"const": 1}}, "required": ["captureIndex"]},
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {"type": "object", "properties": {"captureIndex": {"const": 2}}, "required": ["captureIndex"]},
                    "minContains": 1,
                    "maxContains": 1
                  }
                ]
              },
              "halfTurn": {"$ref": "#/$defs/halfTurn"}
            }
          }
        }
      ]
    }
  }
}
