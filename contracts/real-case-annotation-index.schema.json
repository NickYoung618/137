{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "real-case-annotation-index.schema.json",
  "title": "真实案例同图人工标注索引",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "datasetFingerprint", "createdAtUtc", "counts", "entries"],
  "properties": {
    "schemaVersion": {"const": "real-case-annotation-index/1"},
    "datasetId": {"type": "string", "minLength": 1},
    "datasetFingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "createdAtUtc": {"type": "string", "format": "date-time"},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "reviewed", "pending"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "reviewed": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0}
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["imageId", "relativeImagePath", "imageSha256", "annotationRelativePath", "annotationSha256", "annotationVersion", "annotator", "reviewer", "reviewStatus", "humanVerified", "independentFromAlgorithm", "split", "rejectionReasons"],
        "properties": {
          "imageId": {"type": "string", "minLength": 1},
          "relativeImagePath": {"type": "string", "minLength": 1},
          "imageSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "annotationRelativePath": {"type": "string", "minLength": 1},
          "annotationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "annotationVersion": {"type": "string", "minLength": 1},
          "annotator": {"type": ["string", "null"]},
          "reviewer": {"type": ["string", "null"]},
          "reviewStatus": {"enum": ["template", "draft", "reviewed", "rejected"]},
          "humanVerified": {"type": "boolean"},
          "independentFromAlgorithm": {"type": "boolean"},
          "split": {"type": "string", "minLength": 1},
          "rejectionReasons": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
