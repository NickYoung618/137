{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physical-circle-edge-family-diagnostic.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "enabled", "strategyVersion", "status", "rayCount",
    "candidateCount", "missingRayCount", "seedCount", "hypothesisCount",
    "familyCount", "qualifiedFamilyCount", "families", "selectedFamilyId",
    "failedChecks", "timingMs"
  ],
  "properties": {
    "schemaVersion": {"const": "physical-circle-edge-family-selection/1"},
    "enabled": {"type": "boolean"},
    "strategyVersion": {"type": "string", "minLength": 1},
    "status": {"enum": ["disabled", "selected", "no_family", "ambiguous", "overflow", "invalid"]},
    "rayCount": {"type": "integer", "minimum": 0},
    "candidateCount": {"type": "integer", "minimum": 0},
    "missingRayCount": {"type": "integer", "minimum": 0},
    "seedCount": {"type": "integer", "minimum": 0},
    "hypothesisCount": {"type": "integer", "minimum": 0},
    "familyCount": {"type": "integer", "minimum": 0},
    "qualifiedFamilyCount": {"type": "integer", "minimum": 0},
    "families": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "familyId", "circle", "supportRayCount", "angularCoverage",
          "residualMedianPx", "residualP95Px", "memberHypothesisCount",
          "status", "failedChecks"
        ],
        "properties": {
          "familyId": {"type": "string", "pattern": "^edge-family-[0-9]{3}$"},
          "circle": {
            "type": "object", "additionalProperties": false,
            "required": ["centerX", "centerY", "radiusPx"],
            "properties": {
              "centerX": {"type": "number"},
              "centerY": {"type": "number"},
              "radiusPx": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "supportRayCount": {"type": "integer", "minimum": 0},
          "angularCoverage": {"type": "number", "minimum": 0, "maximum": 1},
          "residualMedianPx": {"type": ["number", "null"], "minimum": 0},
          "residualP95Px": {"type": ["number", "null"], "minimum": 0},
          "memberHypothesisCount": {"type": "integer", "minimum": 1},
          "status": {"enum": ["qualified", "rejected"]},
          "failedChecks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "selectedFamilyId": {"type": ["string", "null"], "pattern": "^edge-family-[0-9]{3}$"},
    "failedChecks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "timingMs": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateExtraction", "familySelection", "robustFit", "total"],
      "properties": {
        "candidateExtraction": {"type": "number", "minimum": 0},
        "familySelection": {"type": "number", "minimum": 0},
        "robustFit": {"type": "number", "minimum": 0},
        "total": {"type": "number", "minimum": 0}
      }
    }
  }
}
